rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Shared data model (docs/DATA_MODEL.md) ───────────────────────────
    // ALL writes go through the backend (firebase-admin bypasses these
    // rules), so scoring, risk and ASHA flags can't be skipped or faked
    // from a phone. The app may only READ its own mother's data.

    function ownsMother(motherId) {
      return request.auth != null
        && get(/databases/$(database)/documents/mothers/$(motherId)).data.appUid == request.auth.uid;
    }

    match /mothers/{motherId} {
      allow read: if request.auth != null && resource.data.appUid == request.auth.uid;
      allow write: if false;

      match /entries/{entryId} {
        allow read: if ownsMother(motherId);
        allow write: if false;
      }
    }

    // ashaWorkers/ and followUps/ are backend-only (ASHA dashboard, Phase 4).
    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
